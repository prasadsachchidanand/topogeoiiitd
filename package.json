{
  "name": "iiitd-topology-geometry-seminar",
  "version": "2.0.0",
  "private": true,
  "description": "Template-driven website for the IIIT Delhi Topology and Geometry Seminar",
  "scripts": {
    "build": "node scripts/build.js && npm run build:css",
    "build:css": "tailwindcss -i ./assets/tailwind.css -o ./dist/assets/site.css --minify",
    "check": "node scripts/check-built.js",
    "dev": "npm run build && node scripts/serve.js",
    "new-series": "node scripts/new-series.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
